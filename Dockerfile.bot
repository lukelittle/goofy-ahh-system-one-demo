# The Discord bot, as a small non-root image.
#
# The TypeScript is bundled to one plain JavaScript file at build time
# (npm run build:bot), so the runtime image has no compiler, no TypeScript
# loader and only production dependencies. No secrets are baked in:
# DISCORD_TOKEN and CIRCUIT_API_KEY are injected at runtime.

FROM node:22.22.2-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
COPY bot ./bot
RUN npm run build:bot

FROM node:22.22.2-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build --chown=node:node /app/dist ./dist
# uid/gid 1000 is the image's unprivileged "node" user; numeric so the runtime can verify it
USER 1000:1000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8080/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "dist/bot.mjs"]
