# Copy to .env.local and fill in.

# A free key for the hosted Circuit API: https://decisioncircuits.com/#api
CIRCUIT_API_KEY=

# Where to send System One requests. Default: the hosted API.
# For the open-weights server running locally (see README, "Running locally"):
# CIRCUIT_URL=http://localhost:8901/v1/systemone
# CIRCUIT_URL=https://api.decisioncircuits.com/v1/systemone

# Which model to ask. Default: circuit-vl-4b
# CIRCUIT_MODEL=circuit-vl-4b

# 1 = never call a model; return hash-derived numbers that are loudly labelled MOCK.
# For working on the UI offline only.
# CIRCUIT_MOCK=0

# --- Discord bot (npm run bot) ---
# From https://discord.com/developers/applications, your application:
# Bot > Reset Token
# DISCORD_TOKEN=
# General Information > Application ID (used by npm run bot:register)
# DISCORD_CLIENT_ID=
# Optional: register the commands in one server so they show up instantly
# DISCORD_GUILD_ID=
# Optional: channel for welcome messages (default: the server's system channel)
# DISCORD_WELCOME_CHANNEL_ID=
# Optional: link to the website, shown in /howitworks
# DEMO_URL=
# Gap between Circuit-VL calls in ms (the free tier allows 60 a minute)
# CIRCUIT_MIN_INTERVAL_MS=1100
